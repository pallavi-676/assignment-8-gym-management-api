{
  "info": {
    "name": "Gym & Fitness Club Management API",
    "_postman_id": "6b0c4f4d-08-gym-api",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5050"
    },
    {
      "key": "classId",
      "value": ""
    },
    {
      "key": "memberId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Register Member",
      "request": {
        "method": "POST",
        "header": [
          {"key": "Content-Type", "value": "application/json"}
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"fit_sam\",\n  \"email\": \"sam@fit.com\",\n  \"password\": \"mypassword\",\n  \"membershipTier\": \"Gold\",\n  \"durationMonths\": 3,\n  \"emergencyContact\": \"9999999999\"\n}"
        },
        "url": "{{baseUrl}}/api/auth/register"
      }
    },
    {
      "name": "Login",
      "request": {
        "method": "POST",
        "header": [
          {"key": "Content-Type", "value": "application/json"}
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"fit_sam\",\n  \"password\": \"mypassword\"\n}"
        },
        "url": "{{baseUrl}}/api/auth/login"
      }
    },
    {
      "name": "My Profile",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/auth/me"
      }
    },
    {
      "name": "Create Fitness Class",
      "request": {
        "method": "POST",
        "header": [
          {"key": "Content-Type", "value": "application/json"}
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Zumba Cardio\",\n  \"trainerName\": \"Maria\",\n  \"scheduleDate\": \"2026-10-15T09:00:00Z\",\n  \"durationMinutes\": 60,\n  \"maxCapacity\": 2\n}"
        },
        "url": "{{baseUrl}}/api/classes"
      }
    },
    {
      "name": "Get Upcoming Classes",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/classes"
      }
    },
    {
      "name": "Get Class By ID",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/classes/{{classId}}"
      }
    },
    {
      "name": "Book Class",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/classes/{{classId}}/book"
      }
    },
    {
      "name": "Cancel Booking",
      "request": {
        "method": "DELETE",
        "url": "{{baseUrl}}/api/classes/{{classId}}/cancel"
      }
    },
    {
      "name": "Renew Membership",
      "request": {
        "method": "PATCH",
        "header": [
          {"key": "Content-Type", "value": "application/json"}
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"additionalMonths\": 6,\n  \"tier\": \"Platinum\"\n}"
        },
        "url": "{{baseUrl}}/api/members/{{memberId}}/renew"
      }
    },
    {
      "name": "Get Expired Members",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/members/expired"
      }
    },
    {
      "name": "Logout",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/auth/logout"
      }
    }
  ]
}